{
  "name": "yapi-flow",
  "version": "0.1.0",
  "private": true,
  "description": "YApi Flow — AI-powered API contract factory + full-stack code generation engine",
  "keywords": [
    "yapi",
    "openapi",
    "swagger",
    "code-generator",
    "typescript",
    "java",
    "go",
    "api-contract",
    "llm",
    "ai"
  ],
  "homepage": "https://github.com/duicym/yapi-flow#readme",
  "bugs": {
    "url": "https://github.com/duicym/yapi-flow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duicym/yapi-flow.git"
  },
  "license": "MIT",
  "author": "duicym",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
